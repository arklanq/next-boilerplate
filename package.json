{
  "name": "next-boilerplate",
  "description": "Next.js based boilerplate",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "rm -rf .next/standalone/public .next/standalone/.next/static && cp -r public .next/standalone/public && cp -r .next/static .next/standalone/.next/static",
    "start": "node .next/standalone/server.js",
    "format": "prettier --log-level \"warn\" --write --cache \"{src,tests,@types,scripts}/**/*.{ts,tsx}\"",
    "lint": "eslint --fix --cache --cache-location \"node_modules/.cache/eslint/.eslint-cache\" \"{src,tests,@types,scripts}/**/*.{ts,tsx}\"",
    "lint:check": "eslint --cache --cache-location \"node_modules/.cache/eslint/.eslint-cache\" \"{src,tests,@types,scripts}/**/*.{ts,tsx}\"",
    "type:check": "tsc --noEmit",
    "test": "bun run test:unit && bun run test:e2e",
    "test:ci": "bun run test:unit --coverage --bail=1 && bun run test:e2e",
    "test:unit": "bun --bun vitest run --project=unit-dom --project=unit-node",
    "test:e2e": "playwright test",
    "test:coverage": "bun --bun vitest run --coverage",
    "test:watch": "bun --bun vitest",
    "clear-cache": "rimraf node_modules/.cache .next .swc",
    "check-updates": "ncu --configFileName ncu.config.js",
    "force-updates": "ncu --configFileName ncu.config.js -u"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@react-hookz/web": "^26.1.0",
    "@tabler/icons-react": "^3.48.0",
    "@tanstack/react-query": "^5.104.0",
    "assert": "^2.1.0",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "cookies-next": "^6.1.1",
    "date-fns": "^4.4.0",
    "debug": "^4.4.3",
    "enhanced-exception": "^1.0.3",
    "http-status": "^2.1.0",
    "immer": "^11.1.18",
    "next": "~16.3.7",
    "next-recompose-plugins": "^3.0.1",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.1",
    "react": "~19.3.0",
    "react-dom": "~19.3.0",
    "react-error-boundary": "^6.1.6",
    "react-hook-form": "^7.89.0",
    "react-hot-toast": "^2.6.1",
    "react-transition-group": "^4.4.5",
    "remeda": "^2.50.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/env": "16.3.7",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.104.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/assert": "^1.5.11",
    "@types/debug": "^4.1.13",
    "@types/node": "^26.6.3",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@types/react-transition-group": "^4.4.12",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "~16.3.7",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.12.0",
    "jsdom": "29.1.1",
    "npm-check-updates": "^23.1.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "tw-animate-css": "^1.4.0",
    "type-fest": "^5.10.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  }
}
