{
  "name": "next-boilerplate",
  "description": "Next.js based boilerplate",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "rm -rf .next/standalone/public .next/standalone/.next/static && cp -r public .next/standalone/public && cp -r .next/static .next/standalone/.next/static",
    "start": "bun .next/standalone/server.js",
    "format": "bun fmt \"{src,tests,@types,scripts}/**/*.{ts,tsx}\"",
    "lint": "eslint --fix --cache --cache-location \"node_modules/.cache/eslint/.eslint-cache\" \"{src,tests,@types,scripts}/**/*.{ts,tsx}\"",
    "lint:check": "eslint --cache --cache-location \"node_modules/.cache/eslint/.eslint-cache\" \"{src,tests,@types,scripts}/**/*.{ts,tsx}\"",
    "type:check": "bun check",
    "test": "bun run test:unit && bun run test:e2e",
    "test:ci": "bun run test:unit --bail=1 && bun run test:e2e",
    "test:unit": "bun test --parallel",
    "test:e2e": "playwright test",
    "test:watch": "bun test --parallel --watch",
    "clear-cache": "rimraf node_modules/.cache .next .swc",
    "updates:check": "ncu --configFileName ncu.config.js",
    "updates:force": "ncu --configFileName ncu.config.js -u"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.0",
    "@react-hookz/web": "^26.1.0",
    "@tabler/icons-react": "^3.49.0",
    "@tanstack/react-query": "^5.104.5",
    "@ui-sdk/core": "^0.1.0-beta.1",
    "@ui-sdk/react": "^0.1.0-beta.1",
    "assert": "^2.1.0",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "cookies-next": "^6.1.1",
    "date-fns": "^4.4.0",
    "debug": "^4.4.3",
    "enhanced-exception": "^1.0.3",
    "http-status": "^2.1.0",
    "immer": "^11.2.9",
    "next": "~16.4.2",
    "next-recompose-plugins": "^3.0.1",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.2",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-hook-form": "^7.90.0",
    "react-hot-toast": "^2.6.1",
    "react-transition-group": "^4.4.5",
    "remeda": "^2.53.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@happy-dom/global-registrator": "^21.0.4",
    "@next/env": "16.4.2",
    "@playwright/test": "^1.64.1",
    "@tanstack/react-query-devtools": "^5.104.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/assert": "^1.5.11",
    "@types/bun": "^1.4.3",
    "@types/debug": "^4.1.13",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@types/react-transition-group": "^4.4.12",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "~16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.13.0",
    "npm-check-updates": "^23.1.1",
    "rimraf": "^6.1.3",
    "tslib": "^2.8.1",
    "type-fest": "^5.10.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "packageManager": "bun@1.4.4"
}
